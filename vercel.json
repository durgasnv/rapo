{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "apps/web",
      "framework": "nextjs"
    },
    "backend": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "api_entry:app",
      "installCommand": "uv sync --frozen --no-dev",
      "functions": {
        "api_entry.py": {
          "maxDuration": 300,
          "excludeFiles": "{apps/web/**,node_modules/**,tests/**,docs/**,.venv/**}"
        }
      },
      "rewrites": [{ "source": "/api/:path*", "destination": "/:path*" }]
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": { "service": "backend" } },
    { "source": "/", "destination": { "service": "frontend", "path": "/" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
