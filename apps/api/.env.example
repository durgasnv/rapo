# Copy to apps/api/.env and pass --env-file apps/api/.env to uvicorn.
# Match the password, database name, and host port configured in the root .env.
RAPO_DATABASE_URL=postgresql+psycopg://rapo:change-me-local-only@localhost:5432/rapo
RAPO_CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'
# Enable this for HTTPS deployments. Local HTTP needs false.
RAPO_COOKIE_SECURE=false

# Password reset: Gmail SMTP (use an app password, never your account password).
RAPO_SMTP_HOST=smtp.gmail.com
RAPO_SMTP_PORT=587
RAPO_SMTP_SECURITY=starttls
RAPO_SMTP_USERNAME=you@gmail.com
RAPO_SMTP_SENDER=you@gmail.com
# Set locally; keep it out of version control. Empty disables new reset requests.
RAPO_SMTP_PASSWORD=
RAPO_RESET_FRONTEND_URL=http://localhost:3000
